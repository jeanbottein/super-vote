<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later (allowBackup="false" before it): nothing goes to the cloud, the voter token above all;
     a transfer to the person's new phone takes everything, so their polls and ballots stay theirs. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
