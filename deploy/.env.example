# super-vote's settings on its server (deploy/compose.yaml): copy this file to
# .env beside it, fill it in, and let only its owner read it (chmod 600 .env).
# The two secrets never leave this machine: not in the repository, an image, a
# message, nor a backup.

# The site's address. Its DNS, and www.'s, point to this machine.
SUPER_VOTE_DOMAIN=super-vote.org

# Keys who owns each ballot, and signs invitation links: openssl rand -base64 48
# Never change it while polls are open: their voters would be told they have
# not voted, and their invitation links would stop working.
SUPER_VOTE_VOTER_SECRET=

# The database's password: openssl rand -hex 32
POSTGRES_PASSWORD=

# Which images run: main, the latest, or a commit's full SHA to go back to it.
SUPER_VOTE_TAG=main
