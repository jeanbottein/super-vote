# super-vote's one public address, HTTPS only: the web app, its API and the
# MCP tools on one origin. Caddy is all the internet reaches (ports 80 and
# 443): it gets and renews the certificate, sends HTTP on to HTTPS, serves the
# built web app, and passes the API to the Java server, which only this
# machine reaches. See deploy/README.md.
{
	# Caddy's own messages, without the request each one is about: that names
	# the visitor's address and the page, a poll's link included, and a line is
	# written each time someone leaves a poll's live results. super-vote writes
	# no address down, and keeps no record of who opened which poll.
	log {
		format filter {
			request delete
		}
	}
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

{$SUPER_VOTE_DOMAIN:super-vote.org} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The hash is index.html's inline script, which sets the appearance before the first paint
		# (clients/web/src/app/contentSecurityPolicy.test.ts keeps them in step).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-NiP4PN1Ip4U9p3WU2wr9c1bguCRqLCQkzqfDuaqELi4='; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		# Other sites' pages can neither reach into a super-vote window they opened nor read its files.
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		# A poll's address is its key: no other site learns it from a link followed.
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# /actuator/health is for an uptime monitor: {"status":"UP"}, or DOWN with a 503 when the server cannot
	# reach its database. The rest of the actuator stays out of reach.
	@server path /api/* /v3/api-docs /v3/api-docs/* /v3/api-docs.yaml /llms.txt /actuator/health
	handle @server {
		request_body {
			max_size 64KB
		}
		# While the server restarts (a new version going out), a request waits for
		# it, 15 seconds at most, rather than failing. Caddy sends a request again
		# only if the server never received it, or if it is a GET, which changes
		# nothing: no ballot or poll is ever made twice.
		reverse_proxy {$SUPER_VOTE_SERVER:127.0.0.1:8080} {
			lb_try_duration 15s
		}
	}

	handle {
		root * {$SUPER_VOTE_WEB:/srv/web}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control no-cache
		# Unlisted polls stay out of search engines, even when someone posts a link.
		header /p/* X-Robots-Tag noindex
		try_files {path} /index.html
		file_server
	}
}

www.{$SUPER_VOTE_DOMAIN:super-vote.org} {
	redir https://{$SUPER_VOTE_DOMAIN:super-vote.org}{uri} permanent
}
